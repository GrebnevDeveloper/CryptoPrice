<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.coinlist.CoinListFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="16sp"
            tools:text="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/last_update"
            android:textSize="12sp"
            tools:text="@string/last_update" />

            <TextView
                android:id="@+id/tvTimeLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="@string/loading"
                tools:text="12:54:12" />
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_per_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.2"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_symbols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/coin"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/gl_per_20"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TextAppearance.Material3.BodySmall"
            tools:text="Монета"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_per_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/price_list_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/gl_per_20"
            app:layout_constraintEnd_toEndOf="@id/gl_per_50"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TextAppearance.Material3.BodySmall"
            tools:text="Цена"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_per_70"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.7"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_change_pct_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change_pct_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/gl_per_50"
            app:layout_constraintEnd_toEndOf="@id/gl_per_70"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TextAppearance.Material3.BodySmall"
            tools:text="24ч."/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_mkt_cap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mktcap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/gl_per_70"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TextAppearance.Material3.BodySmall"
            tools:text="Капитализация"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/pb_loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        tools:visibility="visible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_coin_price_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_coin_info" />

</LinearLayout>