<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_per_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.2"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_logo_coin"
        android:layout_width="@dimen/coinItemImageSize"
        android:layout_height="@dimen/coinItemImageSize"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/gl_per_20"
        app:shapeAppearance="@style/CircleImageView"
        tools:srcCompat="@tools:sample/avatars" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_symbols"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/iv_logo_coin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/gl_per_20"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/TextAppearance.Material3.BodyLarge"
        tools:text="BTC"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_per_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/gl_per_20"
        app:layout_constraintEnd_toEndOf="@id/gl_per_50"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/TextAppearance.Material3.BodyLarge"
        tools:text="$ 123,456.41"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_per_70"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.7"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_change_pct_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/gl_per_50"
        app:layout_constraintEnd_toEndOf="@id/gl_per_70"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/TextAppearance.Material3.BodyLarge"
        tools:text="1234.41%"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_mkt_cap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/gl_per_70"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/TextAppearance.Material3.BodyLarge"
        tools:text="$ 1,234.56 B"/>

</androidx.constraintlayout.widget.ConstraintLayout>